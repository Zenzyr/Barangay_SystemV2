# Copy to /opt/barangay/backend/.env.production on the VPS (chmod 600).
# Read only by the barangay-server container. Never commit the real file.
#
# Set by docker-compose.prod.yml, do not add here:
#   MONGODB_URI   built from MONGO_APP_* in the root .env
#                 (mongodb://<user>:<password>@barangay-mongo:27017/bims?authSource=bims)
#   CORS_ORIGINS  = PUBLIC_URL from the root .env (https://bims-rabon-elyu.site)
#   NODE_ENV, PORT

# Required. At least 32 characters: openssl rand -hex 48
JWT_SECRET=<strong-production-secret>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

IPROG_API_TOKEN=
IPROG_SENDER_NAME=

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_VERSION=
ID_VERIFY_API_KEY=
ID_VERIFY_MODEL=
AI_ANALYTICS_API_KEY=
AI_ANALYTICS_MODEL=
CHATBOT_API_KEY=
CHATBOT_MODEL=
OCR_SPACE_API_KEY=

PAYMONGO_SECRET_KEY=<paymongo-secret-key>

SECRETARY_EMAIL=
SECRETARY_PASSWORD=
SECRETARY_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
